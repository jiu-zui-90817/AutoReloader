{
  "_type_lists": {
    "InfantryTypes": {
      "desc_zh": "步兵单位注册表。这里列出的 ID 才会作为步兵被游戏识别。",
      "desc_en": "Infantry unit registry"
    },
    "VehicleTypes": {
      "desc_zh": "载具单位注册表（坦克、矿车、舰船等）。",
      "desc_en": "Vehicle unit registry"
    },
    "AircraftTypes": {
      "desc_zh": "飞行单位注册表（战机、直升机等）。",
      "desc_en": "Aircraft unit registry"
    },
    "BuildingTypes": {
      "desc_zh": "建筑注册表（基地、防御塔、生产建筑等）。",
      "desc_en": "Building registry"
    },
    "WeaponTypes": {
      "desc_zh": "武器定义。单位的 Primary/Secondary 会指向这里的 ID。",
      "desc_en": "Weapon definitions"
    },
    "Warheads": {
      "desc_zh": "弹头定义。决定伤害类型、百分比伤害、特殊效果等。",
      "desc_en": "Warhead definitions"
    },
    "ProjectileTypes": {
      "desc_zh": "抛射体定义（子弹飞行方式、轨迹等）。",
      "desc_en": "Projectile definitions"
    },
    "SuperWeaponTypes": {
      "desc_zh": "超级武器注册表。",
      "desc_en": "Super weapon registry"
    },
    "TaskForces": {
      "desc_zh": "AI 特遣部队：规定一支小队由哪些单位、各多少个组成。",
      "desc_en": "AI TaskForces"
    },
    "ScriptTypes": {
      "desc_zh": "AI 脚本：规定小队的行动序列（移动、攻击、部署等）。",
      "desc_en": "AI Scripts"
    },
    "TeamTypes": {
