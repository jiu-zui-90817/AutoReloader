--- a/src/Ext/Techno/Body.Update.cpp
+++ b/src/Ext/Techno/Body.Update.cpp
@@ -15,6 +15,14 @@
 void TechnoExt::OnEarlyUpdate()
 {
 	this->UpdateShield();
+
+	// AutoReloader: a type INI reload bumped AE_RefreshVersion; reapply on game thread.
+	if (this->TypeExtData && this->AE_SeenVersion != this->TypeExtData->AE_RefreshVersion)
+	{
+		this->AE_SeenVersion = this->TypeExtData->AE_RefreshVersion;
+		this->UpdateSelfOwnedAttachEffects();
+	}
+
 	this->UpdateAttachEffects();
 	this->EatPassengers();
 	this->ApplySpawnLimitRange();
